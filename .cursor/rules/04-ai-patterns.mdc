## AI Provider abstraction layer

All AI calls go through the `AIRouter` service — never call Bedrock directly from business logic.

```python
# services/ai/router.py
class AIRouter:
    def get_model(self, thread_type: ThreadType, budget_warning: bool = False) -> str:
        """Return the Bedrock model ID for this thread type."""
        rule = self.routing_rules.get(thread_type)
        if budget_warning and rule.fallback_model:
            return rule.fallback_model
        return rule.default_model

# services/ai/client.py  
class AIClient:
    def __init__(self, router: AIRouter):
        self.router = router
        self.bedrock = boto3.client("bedrock-runtime")
    
    async def stream(self, thread_type: ThreadType, context: AssembledContext) -> AsyncIterator[str]:
        model_id = self.router.get_model(thread_type)
        # ... call bedrock, stream response
```

## Context assembly order — always follow this exactly

Build context in this order for every AI call:

```python
def assemble_context(thread: Thread, task: Task, message: str) -> AssembledContext:
    return AssembledContext(
        system_prompt="\n\n".join([
            instruction_layer.platform,      # 1. Platform instructions (cached)
            instruction_layer.org or "",     # 2. Org instructions (cached)
            instruction_layer.user or "",    # 3. User instructions (cached)
            instruction_layer.cluster or "", # 4. Cluster instructions
            instruction_layer.task or "",    # 5. Task-wide instructions
            instruction_layer.thread or "",  # 6. Thread instance instructions
            f"Working language: {task.working_language.value}",  # 7. Language directive
        ]),
        context_blocks=[
            task_context_block(task),        # 7. Task metadata and context
            task_memory_block(task.memory),  # 8. Task memory (structured first, then free-form)
            thread_documents_block(thread),  # 9. Thread-pinned documents (full text)
            rag_chunks_block(retrieved),     # 10. RAG retrieved chunks (ranked by relevance)
            qa_responses_block(thread),      # 11. Structured Q&A responses
        ],
        messages=conversation_history(thread),  # 12. Conversation history (recent first)
        current_message=message                 # 13. Current user message
    )
```

## Prompt caching — always cache these

Platform, org, and user level instructions are identical across calls for a given user. Use Bedrock prompt caching:

```python
# Mark cacheable content with cache_control
system_blocks = [
    {"type": "text", "text": platform_instructions, 
     "cache_control": {"type": "ephemeral"}},  # Cache platform instructions
    {"type": "text", "text": org_instructions,
     "cache_control": {"type": "ephemeral"}},  # Cache org instructions
    {"type": "text", "text": user_instructions,
     "cache_control": {"type": "ephemeral"}},  # Cache user instructions
    {"type": "text", "text": task_instructions},  # Task-wide — don't cache
    {"type": "text", "text": thread_instructions},  # Per-thread instance — don't cache
]
```

## Structured output — JSON + Pydantic

All task memory writes must be structured JSON validated against Pydantic schemas before DB write.

```python
# schemas/task_memory.py
from pydantic import BaseModel
from enum import Enum
from typing import Literal

class EntryType(str, Enum):
    FINDING = "finding"
    ASSUMPTION = "assumption"
    GAP = "gap"
    REFERENCE = "reference"

class TaskMemoryEntry(BaseModel):
    type: EntryType
    content: str
    confidence: float  # 0.0 to 1.0
    source_chunk_ids: list[str]
    thread_id: str
    model_id: str
    instruction_version: str

# In AI service — validate before writing
def write_task_memory(raw_json: str, thread_id: str) -> TaskMemoryEntry:
    try:
        data = json.loads(raw_json)
        entry = TaskMemoryEntry(**data, thread_id=thread_id)
        return entry
    except (json.JSONDecodeError, ValidationError) as e:
        logger.warning("task_memory_validation_failed", error=str(e), raw=raw_json)
        # Retry with explicit error feedback to the model
        raise StructuredOutputError(f"Invalid task memory entry: {e}")
```

## RAG retrieval

Always go through the RAG service abstraction — never query pgvector directly from business logic.

```python
# services/rag/retriever.py
class RAGRetriever:
